{
  "name": "editweave-mcp",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Experimental MCP server for safe AI-assisted editing of collaborative cloud documents, starting with Microsoft Word Online",
  "type": "module",
  "engines": {
    "node": ">=22.10.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/mcp/server.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run test",
    "probe:word": "node --experimental-strip-types scripts/probe-word-online.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^4.6.7",
    "playwright": "^1.65.1"
  },
  "license": "MIT"
}
